# MySQL 数据库
MYSQL_URL=mysql+aiomysql://root:1234@localhost:3306/news_app?charset=utf8mb4

# JWT 认证
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 留空会临时生成随机密钥，代价是每次重启后已签发的 token 全部失效
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# DeepSeek API Configuration
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Amap (高德地图) Web API Configuration
# 申请地址: https://lbs.amap.com/api/webservice/create-project
AMAP_API_KEY=your-amap-web-api-key-here

# LangSmith Tracing (可选，用于调试和监控)
# 注册地址: https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__your-langsmith-key-here
LANGCHAIN_PROJECT=travel-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com